---
/**
 * @title OriginTabs
 * @level origin
 * @description Unstyled headless tabs using native focusgroup with a roving-focus fallback; tabs and panels are supplied via named slots.
 * @category Primitives
 * @hydration optional
 * @accessibility
 * - Render `role="tablist"` with an accessible `label`; native `focusgroup="tablist"` provides one tab stop and arrow keys where supported.
 * - Consumers render `role="tab"` buttons with `aria-selected`, and `role="tabpanel"` elements with `aria-labelledby`; all panels except the selected one must start `hidden`.
 * - Selection is styled from `aria-selected`, never a separate class.
 * @keyboard
 * - `Arrow` keys move between tabs (native focusgroup, or the Part 9.1 fallback); `Home`/`End` jump to first/last.
 * - `Enter`/`Space` selects the focused tab; automatic activation also selects on arrow movement.
 * @slots
 * - `tabs`: `role="tab"` buttons.
 * - `panels`: `role="tabpanel"` regions.
 */

import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"div">, "role" | "aria-label"> & {
  label: string;
  activation?: "automatic" | "manual";
};

const { label, activation = "automatic", ...restProps } = Astro.props;
const rest = { ...restProps };
for (const key of ["role", "aria-label", "tabindex"]) {
  delete (rest as Record<string, unknown>)[key];
}
---

<div data-lsui-tabs data-activation={activation} {...rest}>
  <div
    role="tablist"
    aria-label={label}
    {...{ focusgroup: activation === "manual" ? "tablist nomemory" : "tablist" }}
    data-lsui-tablist
  >
    <slot name="tabs" />
  </div>
  <div data-lsui-panels>
    <slot name="panels" />
  </div>
</div>

<script>
  import {
    createRovingFocus,
    isNativeFocusGroupSupported,
  } from "@lsui/origin/controllers/roving-focus";

  for (const root of document.querySelectorAll<HTMLElement>("[data-lsui-tabs]")) {
    const list = root.querySelector<HTMLElement>('[role="tablist"]');
    if (!list) continue;
    const tabs = [...list.querySelectorAll<HTMLElement>('[role="tab"]')];
    const panels = [
      ...root.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
    ];

    const select = (tab: HTMLElement): void => {
      for (const other of tabs) {
        other.setAttribute("aria-selected", String(other === tab));
      }
      const target = tab.getAttribute("aria-controls");
      for (const panel of panels) {
        const visible = target ? panel.id === target : panel.getAttribute("aria-labelledby") === tab.id;
        if (visible) panel.removeAttribute("hidden");
        else panel.setAttribute("hidden", "until-found");
      }
    };

    for (const tab of tabs) {
      tab.addEventListener("click", () => select(tab));
    }

    if (!isNativeFocusGroupSupported()) {
      createRovingFocus(list, {
        itemSelector: '[role="tab"]',
        onFocusChange: (tab) => {
          if (root.dataset.activation !== "manual") select(tab);
        },
      });
    }
  }
</script>
