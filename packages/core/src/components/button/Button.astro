---
/**
 * @title Button
 * @description Triggers an in-page action, form submission, or declarative dialog/popover command. For URL navigation, use LinkButton instead.
 * @category Actions
 * @hydration optional
 * @accessibility
 * - Renders a native `<button>` element (`type="button"` by default to prevent accidental form submissions).
 * - Enforces >= 24x24px minimum target on desktop and >= 44x44px on coarse touch pointers (WCAG 2.5.8 / 2.5.5).
 * - Supports both `disabled` (removed from tab order) and `aria-disabled="true"` (remains focusable in toolbars/async flows while blocking activation).
 * - Icon-only buttons (`iconOnly`) require an explicit `aria-label` at compile time.
 * @keyboard
 * - `Enter` / `Space`: Activates the button (and dispatches `command` / toggles `popovertarget` when configured).
 * @slots
 * - `default`: Visible button label text.
 * - `icon-start`: Optional leading decorative icon (`aria-hidden="true"` on SVGs).
 * - `icon-end`: Optional trailing decorative icon (`aria-hidden="true"` on SVGs).
 */

import type { HTMLAttributes } from "astro/types";
import type {
  ButtonVariant,
  ControlSize,
  InvokerCommand,
} from "../../contract.js";
import "./button.css";

type NativeButtonAttributes = Omit<
  HTMLAttributes<"button">,
  "type" | "command" | "commandfor" | "popovertarget" | "popovertargetaction"
>;

interface BaseButtonProps extends NativeButtonAttributes {
  /** Visual style token variant. */
  variant?: ButtonVariant | undefined;
  /** Control height and padding scale. */
  size?: ControlSize | undefined;
  /** Native button behavior (`"button"` by default so forms never submit accidentally). */
  type?: "button" | "submit" | "reset" | undefined;
  /** Disables the button and removes it from tab order. Use `aria-disabled="true"` when focus must remain reachable. */
  disabled?: boolean | undefined;
  /** Conditionally renders the component when `true` (omits markup when `false`). */
  render?: boolean | undefined;
  /** Target element ID for the HTML Invoker Commands API (`https://webstatus.dev/features/invoker-commands`). */
  commandfor?: string | undefined;
  /** Built-in or `--custom` command dispatched to `commandfor`. */
  command?: InvokerCommand | undefined;
  /** Target element ID for the HTML Popover API (`https://webstatus.dev/features/popover`). */
  popovertarget?: string | undefined;
  /** Popover action performed when clicked. */
  popovertargetaction?: "toggle" | "show" | "hide" | undefined;
  /** Never pass `href` to `<Button>`; use `<LinkButton href="...">` to preserve native link semantics. */
  href?: never;
}

export type Props = BaseButtonProps &
  (
    | {
        iconOnly?: false | undefined;
        "aria-label"?: string | undefined;
      }
    | {
        iconOnly: true;
        "aria-label": string;
      }
  );

const {
  variant = "primary",
  size = "md",
  type = "button",
  render = true,
  iconOnly = false,
  commandfor,
  command,
  popovertarget,
  popovertargetaction,
  ...rest
} = Astro.props;

const isAriaDisabled =
  rest["aria-disabled"] === true || rest["aria-disabled"] === "true";
const hasInvoker = typeof commandfor === "string" && commandfor.length > 0;
const hasPopover =
  typeof popovertarget === "string" && popovertarget.length > 0;

// Newly shipped HTML attributes cast cleanly onto the spread object without losing strictness on Props
const triggerAttrs: Record<string, string | undefined> = {};
if (hasInvoker) {
  triggerAttrs.commandfor = commandfor;
  if (command !== undefined) triggerAttrs.command = command;
}
if (hasPopover) {
  triggerAttrs.popovertarget = popovertarget;
  if (popovertargetaction !== undefined) {
    triggerAttrs.popovertargetaction = popovertargetaction;
  }
}
---

{
  render && (
    <>
      <button
        type={type}
        data-lsui-button=""
        data-variant={variant}
        data-size={size}
        data-icon-only={iconOnly ? "" : undefined}
        {...triggerAttrs}
        {...rest}
      >
        <slot name="icon-start" />
        <slot />
        <slot name="icon-end" />
      </button>

      {hasInvoker && (
        <script>
          import { ensureInvokerCommandsPolyfill } from "@lsui/behaviors/polyfills";
          void ensureInvokerCommandsPolyfill();
        </script>
      )}

      {hasPopover && (
        <script>
          import { ensurePopoverPolyfill } from "@lsui/behaviors/polyfills";
          void ensurePopoverPolyfill();
        </script>
      )}

      {isAriaDisabled && (
        <script>
          import { ensureAriaDisabledGuard } from "@lsui/behaviors/aria-disabled";
          ensureAriaDisabledGuard();
        </script>
      )}
    </>
  )
}
