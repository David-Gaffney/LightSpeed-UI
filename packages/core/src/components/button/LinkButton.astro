---
/**
 * @title LinkButton
 * @description Navigates to a URL using a semantic `<a>` element styled to match Button variants. Never overrides link semantics with `role="button"`.
 * @category Actions
 * @hydration optional
 * @accessibility
 * - Renders a genuine `<a>` tag so screen readers announce a `link`, right-click / `Cmd+Click` open-in-new-tab works, and browser URL previews stay intact.
 * - When `disabled` is true, omits `href` and sets `role="link"` + `aria-disabled="true"` (W3C HTML-AAM accessible disabled link pattern).
 * - Enforces >= 24x24px minimum target on desktop and >= 44x44px on coarse touch pointers (WCAG 2.5.8 / 2.5.5).
 * - Icon-only link buttons (`iconOnly`) require an explicit `aria-label` at compile time.
 * @keyboard
 * - `Enter`: Follows the link `href` (blocked when `disabled` / `aria-disabled="true"`).
 * @slots
 * - `default`: Visible link label text.
 * - `icon-start`: Optional leading decorative icon (`aria-hidden="true"` on SVGs).
 * - `icon-end`: Optional trailing decorative icon (`aria-hidden="true"` on SVGs).
 */

import type { HTMLAttributes } from "astro/types";
import type { ButtonVariant, ControlSize } from "../../contract.js";
import "./button.css";

type NativeAnchorAttributes = Omit<HTMLAttributes<"a">, "href" | "role">;

interface BaseLinkButtonProps extends NativeAnchorAttributes {
  /** Visual style token variant matching Button. */
  variant?: ButtonVariant | undefined;
  /** Control height and padding scale. */
  size?: ControlSize | undefined;
  /** Conditionally renders the component when `true` (omits markup when `false`). */
  render?: boolean | undefined;
}

type DisabledUnion =
  | {
      /** Destination URL navigated to on activation. */
      href: string | URL;
      /** Active link state (`false` by default). */
      disabled?: false | undefined;
    }
  | {
      /** Omitted from rendered `<a>` when `disabled` is `true`. */
      href?: string | URL | undefined;
      /** Renders an accessible disabled link (`role="link" aria-disabled="true"` without `href`). */
      disabled: true;
    };

type IconOnlyUnion =
  | {
      iconOnly?: false | undefined;
      "aria-label"?: string | undefined;
    }
  | {
      iconOnly: true;
      "aria-label": string;
    };

export type Props = BaseLinkButtonProps & DisabledUnion & IconOnlyUnion;

const {
  href,
  variant = "primary",
  size = "md",
  disabled = false,
  render = true,
  iconOnly = false,
  ...rest
} = Astro.props;

const isAriaDisabled =
  disabled ||
  rest["aria-disabled"] === true ||
  rest["aria-disabled"] === "true";
---

{
  render && (
    <>
      <a
        href={isAriaDisabled ? undefined : href}
        role={isAriaDisabled ? "link" : undefined}
        aria-disabled={isAriaDisabled ? "true" : undefined}
        data-lsui-button=""
        data-variant={variant}
        data-size={size}
        data-icon-only={iconOnly ? "" : undefined}
        {...rest}
      >
        <slot name="icon-start" />
        <slot />
        <slot name="icon-end" />
      </a>

      {isAriaDisabled && (
        <script>
          import { ensureAriaDisabledGuard } from "@lsui/behaviors/aria-disabled";
          ensureAriaDisabledGuard();
        </script>
      )}
    </>
  )
}
