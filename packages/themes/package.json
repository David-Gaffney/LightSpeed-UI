{
  "name": "@lsui/themes",
  "version": "0.0.1",
  "description": "Semantic CSS token stylesheets, ambient data-* context rules, DESIGN.md, and TOKENS.md presets for LightSpeedUI",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base.css": "./src/base.css",
    "./nordic.css": "./src/themes/nordic/theme.css",
    "./editorial.css": "./src/themes/editorial/theme.css",
    "./themes/*": "./src/themes/*"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
