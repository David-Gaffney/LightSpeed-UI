---
/* The site's brand mark (`TheFrontmatter.svg`), inlined for zero-request first
   paint while keeping its 3:1+ WCAG 1.4.11 contrast across light and dark modes.
   Omits SVG `<clipPath id>` so multiple instances on a page never collide. */
import { logo } from "./logo";

interface Props { class?: string }
const { class: cls = "h-7 w-7" } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" viewBox={`0 0 ${logo.width} ${logo.height}`} class={cls} aria-hidden="true">{logo.paths.map((d) => <path d={d} fill={logo.fill} />)}</svg>
