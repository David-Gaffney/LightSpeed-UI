---
import Logo from "./Logo.astro";
import type { SidebarSection } from "@cloudflare/nimbus-docs/types";
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { Button } from "./ui/button";
import { LinkButton } from "./ui/link-button";
import { ThemeToggle } from "./ui/theme-toggle";
import SearchTrigger from "./ui/search/SearchTrigger.astro";
import { ShortcutsToggle } from "./ui/shortcuts";
import { config } from "virtual:nimbus/config";
import { stripBase, withBase } from "@cloudflare/nimbus-docs/runtime";

interface Props {
  /** Astro collection id for the current page, forwarded from DocsLayout. */
  collection?: string;
  /** Astro entry id for the current page, forwarded from DocsLayout. */
  entryId?: string;
  /**
   * Whether the page has a sidebar to open. When `false`, the mobile
   * menu button is hidden — pages that opted out via `sidebar: false`
   * shouldn't show a button that opens an empty dialog. Default `true`.
   */
  showSidebar?: boolean;
  sections?: SidebarSection[];
}

// `entryId` is part of Props as a forward-compat hook (the version-switcher
// recipe reads it) but the base Header doesn't use it — leave it off the
// destructure to avoid an unused-var warning.
const { collection, showSidebar = true, sections: sectionsProp } = Astro.props;

// Normalize trailing slash so isActive matches sidebar hrefs.
const currentSlug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";
const platformTabs: SidebarSection[] = [
  {
    label: "Overview",
    href: "/",
    isActive: collection === "docs",
  },
  {
    label: "Origin",
    href: "/origin/",
    isActive:
      collection === "origin" ||
      currentSlug === "/origin" ||
      currentSlug.startsWith("/origin/"),
  },
  {
    label: "Liftoff",
    href: "/liftoff/",
    isActive:
      collection === "liftoff" ||
      currentSlug === "/liftoff" ||
      currentSlug.startsWith("/liftoff/"),
  },
  {
    label: "Landing",
    href: "/landing/",
    isActive:
      collection === "landing" ||
      currentSlug === "/landing" ||
      currentSlug.startsWith("/landing/"),
  },
  {
    label: "Apogee",
    href: "/apogee/",
    isActive:
      collection === "apogee" ||
      currentSlug === "/apogee" ||
      currentSlug.startsWith("/apogee/"),
  },
];
const sections = sectionsProp ?? platformTabs;
const showSections = sections.length >= 2;
const homeHref = withBase("/", import.meta.env.BASE_URL);
const resolveSectionHref = (href: string): string =>
  withBase(href, import.meta.env.BASE_URL);
---

<header class="na-header">
  <div class="na-header-bar">
    <div class="na-header-leading">
      <slot name="brand">
        {/* The mark alone; the site title stays as the link's accessible name. */}
        <a href={homeHref} class="na-header-brand">
          <Logo class="na-icon-brand na-shrink-0" />
          <span class="na-visually-hidden">{config.title}</span>
        </a>
      </slot>

      {showSections && (
        <nav aria-label="Sections" class="na-section-tabs na-no-scrollbar">
          {sections.map((section) => (
            <a
              href={resolveSectionHref(section.href)}
              aria-current={section.isActive ? "page" : undefined}
              data-active={section.isActive ? "true" : undefined}
              class="na-section-tab"
            >
              {section.label}
            </a>
          ))}
        </nav>
      )}
    </div>

    <div class="na-header-trailing">
      <slot name="actions" />
      {config.search !== false && <SearchTrigger />}
      {/* Without search, the reader's single-key switch lives here. */}
      {config.search === false && <ShortcutsToggle compact />}
      {config.github && (
        <LinkButton
          href={config.github}
          variant="minimal"
          shape="square"
          size="sm"
          aria-label="GitHub"
          target="_blank"
          rel="noopener"
          class="na-muted-text"
        >
          <Icon name="ph:github-logo" class="na-icon-sm" />
        </LinkButton>
      )}
      <ThemeToggle />
      {showSidebar && (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:list"
          aria-label="Open navigation"
          data-menu-btn
          class="na-menu-btn"
        />
      )}
    </div>
  </div>
  {/* Phones: the tabs on a row of their own under the bar. */}
  {showSections && (
    <nav aria-label="Sections" data-nb-header-tabs class="na-section-tabs-mobile na-no-scrollbar">
      {sections.map((section) => (
        <a
          href={resolveSectionHref(section.href)}
          aria-current={section.isActive ? "page" : undefined}
          data-active={section.isActive ? "true" : undefined}
          class="na-section-tab"
        >
          {section.label}
        </a>
      ))}
    </nav>
  )}
</header>
