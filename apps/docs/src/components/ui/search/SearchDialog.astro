---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { Dialog, DialogClose, DialogContent } from "@/components/ui/dialog";
import { ShortcutsToggle } from "@/components/ui/shortcuts";
---

<Dialog data-slot="search-dialog" aria-label="Search documentation" data-search-dialog>
  <DialogContent class="nob-search-dialog-panel">
    <div class="nob-search-header-wrap">
      <div class="nob-search-header">
        <Icon name="ph:magnifying-glass" class="nob-icon-sm nob-search-muted-icon" />
        <input
          data-search-input
          role="combobox"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-autocomplete="list"
          aria-controls="search-listbox"
          type="text"
          placeholder="Search documentation…"
          class="nob-search-input"
          autocomplete="off"
          spellcheck="false"
          autocorrect="off"
          autocapitalize="none"
        />
        <DialogClose class="nob-search-esc">
          Esc
        </DialogClose>
      </div>

      <div class="nob-search-results-wrap">
        <p data-search-empty role="status" class="nob-search-empty">
          Type to search…
        </p>
        <!-- Hidden while it has no options: an empty listbox is invalid. -->
        <div data-search-results role="listbox" id="search-listbox" aria-label="Results" aria-orientation="vertical" hidden></div>
      </div>
    </div>

    <div class="nob-search-footer">
      <span>↑↓ navigate</span>
      <span>↵ select</span>
      <span>Esc close</span>
      <ShortcutsToggle class="nob-search-shortcuts-toggle" />
    </div>
  </DialogContent>
</Dialog>

<script>
  import "./search.client";
</script>
