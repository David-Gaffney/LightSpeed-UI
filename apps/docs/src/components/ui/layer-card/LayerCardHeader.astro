---
/** LayerCardHeader — recessed header layer of a LayerCard. */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}

// A composing component can pass its own `data-slot` in place of this one.
const { class: className, "data-slot": slot = "layer-card-header", ...attrs } = Astro.props;
---

<div
  data-slot={slot}
  class={cn(
    "nd-layer-card-header",
    className,
  )}
  {...attrs}
>
  <slot />
</div>
