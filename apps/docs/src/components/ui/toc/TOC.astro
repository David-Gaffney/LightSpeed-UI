---
/**
 * TOC — on-this-page nav with scroll-spy. Static rail rendered inline
 * (border-s + S-curve SVGs at indent changes); animated active indicator
 * lives in toc.client.ts.
 *
 * The active link uses the native `scroll-target-group` / `:target-current`
 * pair where available, with the `.target-current` class from the
 * IntersectionObserver client as the cross-browser fallback (BASELINE.md §4).
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import type { TOCItem } from "@cloudflare/nimbus-docs/types";

interface Props extends HTMLAttributes<"div"> {
  headings: TOCItem[];
}

const { headings: allHeadings, class: className, ...attrs } = Astro.props;
// A heading that slugs to "" (an emoji-only `## 🎉`) has no target to link to.
const headings = allHeadings.filter((h) => h.slug);
---

{headings.length > 0 && (
  <div data-slot="toc" data-nb-toc class={cn("toc-container", className)} {...attrs}>
    <h2 class="ne-toc-title">On this page</h2>
    <nav aria-label="Table of contents" class="ne-toc-nav">
      <svg
        data-nb-toc-rail
        aria-hidden="true"
        class="ne-toc-rail"
        fill="none"
      >
        <path
          data-nb-toc-rail-active
          class="ne-toc-rail-active"
          stroke-width="2"
          stroke-linecap="round"
        />
      </svg>

      <ul class="ne-toc-list">
        {headings.map((h, i) => {
          const prevDepth = i > 0 ? headings[i - 1].depth : h.depth;
          const nextDepth = i < headings.length - 1 ? headings[i + 1].depth : h.depth;
          const indent = h.depth - 2;
          const goingDeeper = h.depth > prevDepth;
          const goingShallower = nextDepth < h.depth;

          return (
            <li>
              {goingDeeper && (
                <svg
                  aria-hidden="true"
                  class="ne-toc-curve"
                  style={`margin-inline-start: calc(${prevDepth - 2}rem - 0.0625rem); width: ${h.depth - prevDepth}rem;`}
                  viewBox="0 0 1 1"
                  preserveAspectRatio="none"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  overflow="visible"
                >
                  <path d="M 0 0 C 0 0.5, 1 0.5, 1 1" vector-effect="non-scaling-stroke" />
                </svg>
              )}
              <a
                href={h.href ?? `#${h.slug}`}
                data-astro-reload={h.href ? "" : undefined}
                data-nb-toc-link
                data-nb-slug={h.slug}
                class="ne-toc-link"
                style={`margin-inline-start: calc(${indent}rem - 0.125rem);`}
              >
                <span class="ne-toc-text">{h.text}</span>
                <span aria-hidden="true" class="ne-toc-measure">{h.text}</span>
              </a>
              {goingShallower && (
                <svg
                  aria-hidden="true"
                  class="ne-toc-curve"
                  style={`margin-inline-start: calc(${nextDepth - 2}rem - 0.0625rem); width: ${h.depth - nextDepth}rem;`}
                  viewBox="0 0 1 1"
                  preserveAspectRatio="none"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  overflow="visible"
                >
                  <path d="M 1 0 C 1 0.5, 0 0.5, 0 1" vector-effect="non-scaling-stroke" />
                </svg>
              )}
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
)}

<script>
  import "./toc.client";
</script>
