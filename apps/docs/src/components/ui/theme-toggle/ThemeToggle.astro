---
/**
 * ThemeToggle — light/dark switcher. Persists to localStorage; theme
 * applies to `<html data-mode="dark">` via the inline script in BaseLayout
 * (no FOUC).
 */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {}

const { class: className, ...attrs } = Astro.props;
---

<button
  data-slot="theme-toggle"
  type="button"
  data-nb-theme-toggle
  class={cn("na-theme-toggle", className)}
  {...attrs}
  aria-label="Dark mode"
  aria-pressed="false"
>
  {/* The icons follow `<html data-mode>`, which BaseLayout sets before first paint. */}
  <Icon name="ph:sun" class="na-theme-icon na-theme-icon-sun" />
  <Icon name="ph:moon" class="na-theme-icon na-theme-icon-moon" />
</button>

<script>
  import "./theme-toggle.client";
</script>
