---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { withBase } from "@cloudflare/nimbus-docs/runtime";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  markdownUrl?: string;
  lastUpdated?: Date;
}

const { markdownUrl, lastUpdated, class: className, ...attrs } = Astro.props;
const resolvedMarkdownUrl = markdownUrl
  ? withBase(markdownUrl, import.meta.env.BASE_URL)
  : undefined;

const baseBtn = "nob-page-actions-btn";

// Extra actions (the layout passes Connect MCP) render after the built-in
// ones. Rendered here so an action that renders nothing adds no separator.
const extra = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";

const formattedDate = lastUpdated
  ? new Intl.DateTimeFormat(undefined, { year: "numeric", month: "short", day: "numeric" }).format(lastUpdated)
  : null;
---

{/* A nav: the row is page chrome, so text readers and agents skip it as
    they skip the sidebar, while its controls stay in the tab order. */}
{(markdownUrl || lastUpdated || extra) && (
  <nav
    aria-label="Page actions"
    data-nb-page-actions
    data-slot="page-actions"
    data-pagefind-ignore
    data-md-url={resolvedMarkdownUrl}
    class={cn("not-prose nob-page-actions", className)}
    {...attrs}
  >
    {/* Phones get the short forms ("Oct 12, 2026", "Markdown"), so the row stays on one line. */}
    {lastUpdated && (
      <span class="nob-page-actions-updated">
        <Icon name="ph:clock" class="nob-icon-xs" />
        <span class="nob-sr-only nob-page-actions-updated-label">Updated</span> <time datetime={lastUpdated.toISOString()}>{formattedDate}</time>
      </span>
    )}

    {markdownUrl && lastUpdated && (
      <span aria-hidden="true" data-slot="page-actions-separator" class="nob-page-actions-separator">|</span>
    )}

    {markdownUrl && (
      <>
        <button type="button" data-nb-page-actions-copy class={baseBtn}>
          <Icon name="ph:copy" class="nob-icon-xs" data-nb-page-actions-copy-icon />
          <Icon name="ph:check" class="nob-icon-xs nob-page-actions-check nob-hidden" data-nb-page-actions-check-icon />
          <span data-nb-page-actions-label aria-live="polite">Copy page</span>
        </button>

        <span aria-hidden="true" data-slot="page-actions-separator" class="nob-page-actions-separator">|</span>

        <a
          href={resolvedMarkdownUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View as Markdown"
          class={baseBtn}
        >
          <Icon name="ph:markdown-logo" class="nob-icon-xs" />
          <span class="nob-page-actions-md-short" aria-hidden="true">Markdown</span>
          <span class="nob-page-actions-md-long" aria-hidden="true">View as Markdown</span>
        </a>
      </>
    )}

    {extra && (markdownUrl || lastUpdated) && (
      <span aria-hidden="true" data-slot="page-actions-separator" class="nob-page-actions-separator">|</span>
    )}
    {extra && <Fragment set:html={extra} />}
  </nav>
)}

<script>
  import "./page-actions.client";
</script>
