---
import { variants } from "@/lib/variants";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {
  /** Badge text. When omitted, slotted children render instead. */
  text?: string;
  variant?: "default" | "info" | "note" | "success" | "tip" | "warning" | "caution" | "danger" | "outline";
  size?: "small" | "medium" | "large";
}

const { text, variant, size, class: className, ...attrs } = Astro.props;

// note→info, tip→success, caution→warning: variant aliases
const badge = variants({
  base: "nd-badge",
  variants: {
    variant: {
      default: "nd-badge-default",
      info:    "nd-badge-info",
      note:    "nd-badge-note",
      success: "nd-badge-success",
      tip:     "nd-badge-tip",
      warning: "nd-badge-warning",
      caution: "nd-badge-caution",
      danger:  "nd-badge-danger",
      outline: "nd-badge-outline",
    },
    size: {
      // Whole-pixel heights: 20, 24 and 28.
      small:  "nd-badge-sm",
      medium: "nd-badge-md",
      large:  "nd-badge-lg",
    },
  },
  defaults: { variant: "default", size: "small" },
});
---

<span data-slot="badge" data-variant={variant ?? "default"} class={badge({ variant, size }, className)} {...attrs}>
  {text ?? <slot />}
</span>
