---
/** SidebarFilter — text input that filters the adjacent Sidebar. Its key
 *  (`filterSidebar` in src/lib/shortcuts.ts, "/" by default) focuses it. */
import { shortcutLabel } from "@cloudflare/nimbus-docs/client";
import { cn } from "@/lib/cn";
import { shortcuts } from "@/lib/shortcuts";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  placeholder?: string;
}

const { class: className, placeholder = "Filter…", ...attrs } = Astro.props;
const key = shortcuts.filterSidebar;
---

<div data-slot="sidebar-filter" class={cn("nc-sidebar-filter", className)} {...attrs}>
  <input
    data-nb-sidebar-filter-input
    type="search"
    placeholder={placeholder}
    class="nc-filter-input"
    data-has-key={key ? "" : undefined}
    aria-label="Filter navigation"
    data-nb-shortcut-for={key || undefined}
    autocomplete="off"
  />
  {/* The key's hint. Hidden once the input is focused or has a value. */}
  {key && <kbd
    aria-hidden="true"
    data-nb-shortcut-hint={key}
    class="nc-filter-hint"
    >{shortcutLabel(key)}</kbd
  >}
</div>

<style is:global>
  [data-nb-sidebar-hidden] { display: none; }
</style>
