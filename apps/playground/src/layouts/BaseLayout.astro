---
import "@lsui/themes/base.css";
import "@lsui/themes/nordic.css";
import "@lsui/themes/editorial.css";

export interface Props {
  title: string;
  theme?: string;
}

const { title, theme = "nordic light" } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="text-scale" content="scale" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
